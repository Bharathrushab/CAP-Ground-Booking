rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/cap_admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/cap_admins/$(request.auth.uid)).data.enabled == true
        && firestore.get(/databases/(default)/documents/cap_admins/$(request.auth.uid)).data.role == 'master';
    }

    match /announcement-images/{announcementId}/{fileName} {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if admin();
    }
  }
}