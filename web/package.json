    "firebase": "^11.10.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
